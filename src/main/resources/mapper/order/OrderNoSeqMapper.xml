<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.order.mapper.OrderNoSeqMapper">

    <!-- tOrdOrderNoSeq 는 Seq(auto_increment) 단일 컬럼짜리 채번 전용 테이블.
         행을 하나 추가하고 생성된 Seq 값을 그대로 주문번호로 사용한다. -->
    <insert id="insert" parameterType="com.shopwizard.order.model.OrderNoSeq"
            useGeneratedKeys="true" keyProperty="seq" keyColumn="Seq">
        INSERT INTO shopion.tOrdOrderNoSeq () VALUES ()
    </insert>

</mapper>
