<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.company.mapper.ChnlPolicyMapper">

    <resultMap id="ChnlPolicyResult" type="com.shopwizard.company.model.ChnlPolicy">
        <result property="chnlPolicyCode" column="ChnlPolicyCode"/>
        <result property="chnlPolicyName" column="ChnlPolicyName"/>
        <result property="chnlPolicyDesc" column="ChnlPolicyDesc"/>
        <result property="designCode" column="DesignCode"/>
        <result property="memberChnlCode" column="MemberChnlCode"/>
        <result property="prsdntChnlCode" column="PrsdntChnlCode"/>
        <result property="adjustChnlCode" column="AdjustChnlCode"/>
        <result property="saleFeeRate" column="SaleFeeRate"/>
        <result property="marginSharRate" column="MarginSharRate"/>
        <result property="marginSharStndrdAmt" column="MarginSharStndrdAmt"/>
        <result property="trnsfrFeeRate" column="TrnsfrFeeRate"/>
        <result property="cardFeeRate" column="CardFeeRate"/>
        <result property="hppmFeeRate" column="HppmFeeRate"/>
        <result property="prodLinkYn" column="ProdLinkYn"/>
        <result property="orderLinkYn" column="OrderLinkYn"/>
        <result property="cpnApplyYn" column="CpnApplyYn"/>
        <result property="pointUseYn" column="PointUseYn"/>
        <result property="pointLimitAmt" column="PointLimitAmt"/>
        <result property="pointSaveYn" column="PointSaveYn"/>
        <result property="freeApplyYn" column="FreeApplyYn"/>
        <result property="freeApplyMonth" column="FreeApplyMonth"/>
        <result property="freeApplyAmt" column="FreeApplyAmt"/>
        <result property="linkTermnlCode" column="LinkTermnlCode"/>
        <result property="remark" column="Remark"/>
        <result property="state" column="State"/>
        <result property="registId" column="RegistId"/>
        <result property="registName" column="RegistName"/>
        <result property="registDate" column="RegistDate"/>
        <result property="changeId" column="ChangeId"/>
        <result property="changeName" column="ChangeName"/>
        <result property="changeDate" column="ChangeDate"/>
    </resultMap>

    <select id="selectList" parameterType="map" resultMap="ChnlPolicyResult">
        SELECT *
        FROM shopwizard.tCmpChnlPolicy
        <where>
            <if test="pChnlPolicyCode != null and pChnlPolicyCode != ''">AND ChnlPolicyCode = #{pChnlPolicyCode}</if>
            <if test="pChnlPolicyName != null and pChnlPolicyName != ''">AND ChnlPolicyName LIKE CONCAT('%',#{pChnlPolicyName},'%')</if>
        </where>
        <if test="pPageSize != null and pPageOffset.toString().matches('^[0-9]+$') and pPageSize.toString().matches('^[0-9]+$')">LIMIT ${pPageOffset}, ${pPageSize}</if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM shopwizard.tCmpChnlPolicy
        <where>
            <if test="pChnlPolicyCode != null and pChnlPolicyCode != ''">AND ChnlPolicyCode = #{pChnlPolicyCode}</if>
        </where>
    </select>

    <select id="select" parameterType="map" resultMap="ChnlPolicyResult">
        SELECT *
        FROM shopwizard.tCmpChnlPolicy
        WHERE ChnlPolicyCode = #{chnlPolicyCode}
    </select>

    <select id="selectMax" resultType="string">
        SELECT MAX(ChnlPolicyCode)
        FROM shopwizard.tCmpChnlPolicy
    </select>

</mapper>
