<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.profile.mapper.DeptApprovLineMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.profile.model.DeptApprovLine">
        SELECT * FROM shopion.tPrfDeptApprovLine
        <where>
            <if test="pDeptId != null and pDeptId != ''">AND DeptId = #{pDeptId}</if>
            <if test="pApprovLevel != null and pApprovLevel != ''">AND ApprovLevel = #{pApprovLevel}</if>
        </where>
        <if test="pPageSize != null and pPageSize != ''">LIMIT #{pPageOffset}, #{pPageSize}</if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM shopion.tPrfDeptApprovLine
        <where>
            <if test="pDeptId != null and pDeptId != ''">AND DeptId = #{pDeptId}</if>
            <if test="pApprovLevel != null and pApprovLevel != ''">AND ApprovLevel = #{pApprovLevel}</if>
        </where>
    </select>

    <select id="select" parameterType="map" resultType="com.shopwizard.profile.model.DeptApprovLine">
        SELECT * FROM shopion.tPrfDeptApprovLine WHERE DeptId = #{deptId} AND ApprovLevel = #{approvLevel}
    </select>

</mapper>
