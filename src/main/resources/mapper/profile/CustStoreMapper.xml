<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.profile.mapper.CustStoreMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.profile.model.CustStore">
        SELECT *
        FROM shopion.tPrfCustStore
        <where>
            <if test="pCustId != null and pCustId != ''">AND CustId = #{pCustId}</if>
            <if test="pStoreCode != null and pStoreCode != ''">AND StoreCode = #{pStoreCode}</if>
        </where>
        <if test="pPageSize != null and pPageSize != ''">LIMIT #{pPageOffset}, #{pPageSize}</if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM shopion.tPrfCustStore
        <where>
            <if test="pCustId != null and pCustId != ''">AND CustId = #{pCustId}</if>
            <if test="pStoreCode != null and pStoreCode != ''">AND StoreCode = #{pStoreCode}</if>
        </where>
    </select>

    <select id="select" parameterType="map" resultType="com.shopwizard.profile.model.CustStore">
        SELECT * FROM shopion.tPrfCustStore WHERE CustId = #{custId} AND StoreCode = #{storeCode}
    </select>

</mapper>
