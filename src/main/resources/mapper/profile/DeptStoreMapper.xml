<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.profile.mapper.DeptStoreMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.profile.model.DeptStore">
        SELECT * FROM shopion.tPrfDeptStore
        <where>
            <if test="pDeptId != null and pDeptId != ''">AND DeptId = #{pDeptId}</if>
            <if test="pStoreCode != null and pStoreCode != ''">AND StoreCode = #{pStoreCode}</if>
        </where>
        <if test="pPageSize != null and pPageSize != ''">LIMIT #{pPageOffset}, #{pPageSize}</if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM shopion.tPrfDeptStore
        <where>
            <if test="pDeptId != null and pDeptId != ''">AND DeptId = #{pDeptId}</if>
            <if test="pStoreCode != null and pStoreCode != ''">AND StoreCode = #{pStoreCode}</if>
        </where>
    </select>

    <select id="select" parameterType="map" resultType="com.shopwizard.profile.model.DeptStore">
        SELECT * FROM shopion.tPrfDeptStore WHERE DeptId = #{deptId} AND StoreCode = #{storeCode}
    </select>

</mapper>
