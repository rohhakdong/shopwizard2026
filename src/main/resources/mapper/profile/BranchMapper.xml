<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shopwizard.profile.mapper.BranchMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.profile.model.Branch">
        SELECT *
        FROM shopion.tPrfBranch
        <where>
            <if test="pBranchId != null and pBranchId != ''">AND BranchId = #{pBranchId}</if>
            <if test="pCompCode != null and pCompCode != ''">AND CompCode = #{pCompCode}</if>
            <if test="pBranchName != null and pBranchName != ''">AND BranchName LIKE CONCAT('%',#{pBranchName},'%')</if>
        </where>
        <if test="pPageSize != null and pPageSize != ''">
        LIMIT #{pPageOffset}, #{pPageSize}
        </if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM shopion.tPrfBranch
        <where>
            <if test="pBranchId != null and pBranchId != ''">AND BranchId = #{pBranchId}</if>
            <if test="pCompCode != null and pCompCode != ''">AND CompCode = #{pCompCode}</if>
            <if test="pBranchName != null and pBranchName != ''">AND BranchName LIKE CONCAT('%',#{pBranchName},'%')</if>
        </where>
    </select>

    <select id="select" parameterType="int" resultType="com.shopwizard.profile.model.Branch">
        SELECT *
        FROM shopion.tPrfBranch
        WHERE BranchId = #{value}
    </select>

</mapper>
