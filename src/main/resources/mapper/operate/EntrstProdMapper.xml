<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shopwizard.operate.mapper.EntrstProdMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.operate.model.EntrstProd">
        SELECT * FROM shopion.tOprEntrstProd
        <where>
            <if test="pEntrstNo != null and pEntrstNo != ''">AND EntrstNo = #{pEntrstNo}</if>
            <if test="pCustId != null and pCustId != ''">AND CustId = #{pCustId}</if>
            <if test="pPrgresStateArr != null">
                AND PrgresState IN
                <foreach collection="pPrgresStateArr" item="item" open="(" close=")" separator=",">#{item}</foreach>
            </if>
        </where>
        <if test="pPageSize != null and pPageSize != ''">LIMIT #{pPageOffset}, #{pPageSize}</if>
    </select>

    <select id="selectCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM shopion.tOprEntrstProd
        <where>
            <if test="pEntrstNo != null and pEntrstNo != ''">AND EntrstNo = #{pEntrstNo}</if>
            <if test="pCustId != null and pCustId != ''">AND CustId = #{pCustId}</if>
        </where>
    </select>

    <select id="select" parameterType="map" resultType="com.shopwizard.operate.model.EntrstProd">
        SELECT * FROM shopion.tOprEntrstProd WHERE EntrstNo = #{entrstNo}
    </select>

</mapper>
