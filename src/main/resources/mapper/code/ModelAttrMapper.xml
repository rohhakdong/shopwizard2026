<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shopwizard.code.mapper.ModelAttrMapper">

    <select id="selectList" parameterType="map" resultType="com.shopwizard.code.model.ModelAttr">
        SELECT * FROM tCodModelAttr
        <where>
            <if test="pModelId != null and pModelId != ''">AND ModelId = #{pModelId}</if>
            <if test="pAttrName != null">AND CONCAT(KorWord1,KorWord2,KorWord3,KorWord4,KorWord5) LIKE CONCAT('%',#{pAttrName},'%')</if>
        </where>
        <choose>
            <when test="sidx != null and sidx != ''">ORDER BY ${sidx} ${sord}</when>
            <otherwise>ORDER BY AttrSeq, AttrId</otherwise>
        </choose>
    </select>

</mapper>
